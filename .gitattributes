# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files requiring LF line endings
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.sh text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Explicit binary files
*.tif binary
*.tiff binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.tar binary
*.gz binary
*.pkl binary
*.joblib binary
